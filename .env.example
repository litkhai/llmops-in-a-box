# ═════════════════════════════════════════════════════════════════════════════
#  Sovereign AI Stack — secrets and endpoints
#
#      cp .env.example .env && ./scripts/stack.sh doctor
#
#  stack.yaml references these by NAME only; values never leave this file.
#  Grouped by build-out phase — you only need the Phase 1 block to start.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Required ────────────────────────────────────────────────────────────────
# Master key clients use to reach the gateway. Must start with `sk-`.
#   openssl rand -hex 24 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-change-me


# ═════════════════ Phase 1 — frontier models (current) ═══════════════════════

# ─── Model providers ─────────────────────────────────────────────────────────
# Omit either one; `doctor` warns and the model is still rendered but will
# fail at request time. Use --profile headless to skip the UI entirely.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Langfuse ────────────────────────────────────────────────────────────────
# Leave blank on first boot. Open http://localhost:3000, create an org and
# project, then paste the keys here and re-run:
#   ./scripts/stack.sh up          (restarts litellm so callbacks pick them up)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# Langfuse server secrets — generate both:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
LANGFUSE_SALT=

# ─── Langfuse backing services ───────────────────────────────────────────────
# Internal to the compose network. Change them anyway before any shared deploy.
CLICKHOUSE_PASSWORD=changeme-clickhouse
POSTGRES_PASSWORD=changeme-postgres
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme-minio


# ═════════════════ Phase 2 — MCP tool layer (planned) ════════════════════════

# First MCP server target: ClickHouse Cloud, read-only.
MCP_CLICKHOUSE_URL=
CLICKHOUSE_CLOUD_HOST=
CLICKHOUSE_CLOUD_USER=
CLICKHOUSE_CLOUD_PASSWORD=


# ═════════════════ Phase 3 — self-hosted serving (planned) ═══════════════════

# RunPod vLLM endpoint. Note the /v1 suffix — LiteLLM expects it.
#   https://<pod-id>-8000.proxy.runpod.net/v1
VLLM_API_BASE=
VLLM_API_KEY=


# ═════════════════ Phase 4 — storage and memory (planned) ════════════════════

# Artifact store, separate from the MinIO that backs Langfuse.
ARTIFACT_MINIO_ROOT_USER=
ARTIFACT_MINIO_ROOT_PASSWORD=
